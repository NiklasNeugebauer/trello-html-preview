[
  {
    "id": 1,
    "priority": 2,
    "action": { "type": "allow" },
    "condition": {
      "regexFilter": "^https://trello\\.com/1/cards/[^/]+/attachments/[^/]+/download/[^/?#]+\\?([^#]*&)?dl=1(&|#|$)",
      "resourceTypes": ["main_frame", "sub_frame"]
    }
  },
  {
    "id": 2,
    "priority": 1,
    "action": {
      "type": "modifyHeaders",
      "responseHeaders": [
        { "header": "content-disposition", "operation": "remove" },
        { "header": "content-type", "operation": "set", "value": "text/html" },
        {
          "header": "content-security-policy",
          "operation": "set",
          "value": "sandbox allow-scripts allow-forms allow-modals allow-popups allow-popups-to-escape-sandbox allow-downloads"
        },
        { "header": "content-security-policy-report-only", "operation": "remove" },
        { "header": "x-frame-options", "operation": "remove" }
      ]
    },
    "condition": {
      "regexFilter": "^https://trello\\.com/1/cards/[^/]+/attachments/[^/]+/download/[^/?#]+\\.x?html?([?#].*)?$",
      "resourceTypes": ["main_frame", "sub_frame"]
    }
  }
]
